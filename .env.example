# Token da integração do Notion (obrigatório)
NOTION_TOKEN=ntn_...

# ---------- Notion ----------
# ID de cada database do Campelo Brain (data source) e da sua página no Perfil.
# Não precisa preencher na mão: coloque o NOTION_TOKEN e rode "npm run ids" (no Docker: docker compose run --rm brain-bot node src/descobrir-ids.js). Ele imprime estas linhas.
# O link da database no Notion NÃO serve, o ID dele é outro.
NOTION_DS_PERFIL=
NOTION_DS_MATERIAS=
NOTION_DS_PROJETOS=
NOTION_DS_LIVROS=
NOTION_DS_AVALIACOES=
NOTION_DS_TAREFAS=
NOTION_DS_NOTAS=
NOTION_DS_DIARIO=
NOTION_DS_LANCAMENTOS=
NOTION_DS_RECOMPENSAS=
NOTION_DS_FICHA_TREINO=
NOTION_DS_AREAS=
# ID da SUA página dentro do database Perfil. Tudo que soma XP fica ligado nela. O "npm run ids" também acha este.
NOTION_PERFIL_ID=

# ---------- Seu perfil ----------
# Fuso horário (lista em en.wikipedia.org/wiki/List_of_tz_database_time_zones). Afeta lembretes e datas.
TZ_NAME=America/Sao_Paulo
# Seu nome (opcional, aparece no prompt da IA).
OWNER_NAME=
# Instituição padrão de matéria nova (opcional).
INSTITUICAO_PADRAO=
# Opções do campo Área nas suas databases e qual delas é a do trabalho/clientes.
AREAS=Faculdade,Trabalho,Dev,Pessoal
AREA_TRABALHO=Trabalho
# Apelidos de matérias em JSON (opcional). Ex: {"so":"Sistemas Operacionais","ed":"Estrutura de Dados"}
ALIAS_MATERIAS=
# Latitude e longitude para o clima do bom dia (opcional, sem elas o bom dia sai sem clima).
CLIMA_LAT=
CLIMA_LON=

# Qual IA entende as mensagens: gemini ou claude
PROVIDER=gemini

# Gemini (camada gratuita). Chave em aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Claude (pago). Para trocar, preencha a chave e mude PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Quem pode mandar comandos. Seu número com DDI e DDD, só dígitos. Vários separados por vírgula.
OWNER_NUMBERS=5511999999999

# Chats liberados (grupos). Mande /id no grupo para descobrir o ID.
ALLOWED_CHATS=

# true se o bot rodar no SEU número e você falar com ele em "Mensagem para você mesmo" ou num grupo só seu.
ALLOW_FROM_ME=false

# Vincular por código em vez de QR. Número do WhatsApp que vai rodar o bot, só dígitos. Vazio = QR.
PAIRING_NUMBER=

# Marca "Acordei antes das 6:30" sozinho se a primeira mensagem do dia chegar antes desse horário.
AUTO_ACORDEI=true
ACORDEI_LIMITE=06:30

# Resumo diário (HH:MM). Vazio desliga. RESUMO_CHAT vazio usa o primeiro ALLOWED_CHATS ou o seu número.
RESUMO_DIARIO=06:45
RESUMO_CHAT=
# true = bom dia com clima, sequências e cobrança. false = resumo simples antigo.
BRIEFING=true

# Fechamento do dia (HH:MM): pergunta como foi o dia e grava a resposta no diário. Vazio desliga.
FECHAMENTO_HORA=21:30

# Prefixo das respostas, para diferenciar do que você escreve.
# Aviso antes de tarefas/provas com horário, em minutos (0 desliga). LEMBRETE_CHAT vazio usa o destino do resumo.
LEMBRETE_MIN=30
LEMBRETE_CHAT=

REPLY_PREFIX=🤖 
